diff --git a/llvm/include/llvm/Support/ExponentialBackoff.h b/llvm/include/llvm/Support/ExponentialBackoff.h
index 52696577d3f5..76c6379ae434 100644
--- a/llvm/include/llvm/Support/ExponentialBackoff.h
+++ b/llvm/include/llvm/Support/ExponentialBackoff.h
@@ -16,6 +16,7 @@
 #include "llvm/Support/Compiler.h"
 #include "llvm/Support/Error.h"
 #include <chrono>
+#include <cstdint>
 #include <random>
 
 namespace llvm {
@@ -57,7 +58,11 @@ private:
   duration MinWait;
   duration MaxWait;
   time_point EndTime;
+#if defined(__wasm__) || defined(__wasm32__)
+  uint64_t RandState = 0x9e3779b97f4a7c15ULL;
+#else
   std::random_device RandDev;
+#endif
   int64_t CurrentMultiplier = 1;
 };
 
diff --git a/llvm/lib/Support/ExponentialBackoff.cpp b/llvm/lib/Support/ExponentialBackoff.cpp
index 7e68cf67a79f..e237ce5de864 100644
--- a/llvm/lib/Support/ExponentialBackoff.cpp
+++ b/llvm/lib/Support/ExponentialBackoff.cpp
@@ -17,11 +17,20 @@ bool ExponentialBackoff::waitForNextAttempt() {
     return false;
 
   duration CurMaxWait = std::min(MinWait * CurrentMultiplier, MaxWait);
+#if defined(__wasm__) || defined(__wasm32__)
+  uint64_t Min = static_cast<uint64_t>(MinWait.count());
+  uint64_t Max = static_cast<uint64_t>(CurMaxWait.count());
+  RandState = RandState * 6364136223846793005ULL + 1;
+  uint64_t Span = Max > Min ? Max - Min + 1 : 1;
+  duration WaitDuration =
+      std::min(duration(Min + (RandState % Span)), EndTime - Now);
+#else
   std::uniform_int_distribution<uint64_t> Dist(MinWait.count(),
                                                CurMaxWait.count());
   // Use random_device directly instead of a PRNG as uniform_int_distribution
   // often only takes a few samples anyway.
   duration WaitDuration = std::min(duration(Dist(RandDev)), EndTime - Now);
+#endif
   if (CurMaxWait < MaxWait)
     CurrentMultiplier *= 2;
   std::this_thread::sleep_for(WaitDuration);
