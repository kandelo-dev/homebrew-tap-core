+/*
+ * WHY: DB-lock mode canonicalizes info->path only after PHP's first
+ * same-process conflict check. Repeat the same guard after canonicalization so
+ * a relative-path handle cannot bypass an existing canonical-path lock.
+ */
+static bool php_dba_lock_conflicts(const dba_info *info, int lock_mode)
+{
+	dba_info *other;
 
+	if ((other = php_dba_find(info->path)) == NULL) {
+		return false;
+	}
+
+	return ( (lock_mode&LOCK_EX)        && (other->lock.mode&(LOCK_EX|LOCK_SH)) )
+	    || ( (other->lock.mode&LOCK_EX) && (lock_mode&(LOCK_EX|LOCK_SH))        );
+}
