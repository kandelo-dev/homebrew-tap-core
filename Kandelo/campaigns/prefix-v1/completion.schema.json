{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "campaign": {
      "const": "prefix-v1"
    },
    "campaign_release": {
      "additionalProperties": false,
      "properties": {
        "manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "repository": {
          "const": "kandelo-dev/homebrew-tap-core"
        },
        "tag": {
          "pattern": "^homebrew-prefix-campaign-sha256-[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "manifest_sha256",
        "repository",
        "tag"
      ],
      "type": "object"
    },
    "catalog_cohort_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "expected_parent_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "guest_layout_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "handoffs_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "kind": {
      "const": "kandelo-homebrew-prefix-campaign-completion"
    },
    "schema": {
      "const": 1
    },
    "source": {
      "additionalProperties": false,
      "properties": {
        "manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "source_tree_git_oid": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "target_tree_git_oid": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        }
      },
      "required": [
        "manifest_sha256",
        "source_tree_git_oid",
        "target_tree_git_oid"
      ],
      "type": "object"
    }
  },
  "required": [
    "campaign",
    "campaign_release",
    "catalog_cohort_sha256",
    "expected_parent_commit",
    "guest_layout_sha256",
    "handoffs_sha256",
    "kind",
    "schema",
    "source"
  ],
  "title": "Kandelo Homebrew prefix campaign completion",
  "type": "object"
}
